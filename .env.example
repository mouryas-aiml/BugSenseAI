# ─── LLM Provider ───────────────────────────────────────────────────────────
# Options: gemini (recommended, free), openai, groq, ollama
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=60

# ─── Gemini (recommended — free tier at https://aistudio.google.com/) ────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# ─── OpenAI (paid) ───────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── Groq (free tier at https://console.groq.com/) ──────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Ollama (local, no key needed — run: ollama serve && ollama pull llama3.2)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ─── Slack Bot (optional) ────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_BUGS_CHANNEL=bugs

# ─── Jira (optional) ─────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=BT
